<?xml version="1.0" encoding="utf-8"?>
<!-- NoDrive Microsoft Store package (full-trust desktop app, same Native AOT exe as the MSI).
     @IDENTITY_NAME@, @PUBLISHER@ and @VERSION@ are filled in by tools/build-msix.ps1 (Partner Center > Product identity). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>NoDrive</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="es" />
  </Resources>
  <Applications>
    <Application Id="NoDrive" Executable="NoDrive.Engine.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="NoDrive" Description="OneDrive without the weight: a lightweight OneDrive client with files on demand."
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="NoDrive.Engine.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="NoDriveStartup" Enabled="true" DisplayName="NoDrive" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
