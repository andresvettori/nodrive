<?xml version="1.0" encoding="utf-8"?>
<!--
  NoDrive per-user installer (WiX Toolset v5, MSI). No administrator rights: installs to %LOCALAPPDATA%\Programs\NoDrive.
  Build from the repo root:
    wix build installer/NoDrive.wxs -ext WixToolset.UI.wixext -arch x64 -d EnginePath=<folder with NoDrive.Engine.exe> -d Version=0.9.0 -d DisplayVersion=0.9.0-beta.0 -o NoDrive-x64.msi
  Options (msiexec ... PROPERTY=value): AUTOSTART=0 skips "start with Windows"; SUPPRESSLAUNCH=1 does not start NoDrive after install.
  Upgrades keep the sync root and the user's files. Uninstall quits the engine, refuses while changes are unsynced (use the tray to finish first),
  unregisters the sync root and removes the autostart entry; downloaded files stay on disk.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="NoDrive" Manufacturer="NoDrive" Version="$(Version)" UpgradeCode="6b1c2f0e-8a54-4d3a-9d61-3f7c5a2b9e10" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NoDrive is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="AUTOSTART" Value="1" />
    <Property Id="ARPCOMMENTS" Value="NoDrive $(DisplayVersion)" />
    <Property Id="ARPURLINFOABOUT" Value="https://andresvettori.github.io/nodrive/" />
    <Property Id="ARPHELPLINK" Value="https://andresvettori.github.io/nodrive/" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NoDrive" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="NoDrive" />
    </StandardDirectory>

    <Feature Id="Main" Title="NoDrive" Level="1">
      <Component Id="EngineExe" Directory="INSTALLFOLDER" Guid="c2d33f82-32c9-53ec-b497-3fea81597af7">
        <File Id="EngineExe" Source="$(EnginePath)\NoDrive.Engine.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\NoDrive" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="MenuShortcut" Directory="AppMenuFolder" Guid="aee176bb-00a9-5b4b-b8c1-efc41c3bea96">
        <Shortcut Id="NoDriveShortcut" Name="NoDrive" Description="OneDrive without the weight" Target="[INSTALLFOLDER]NoDrive.Engine.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\NoDrive" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="AutostartEntry" Directory="INSTALLFOLDER" Guid="2f469b22-dc38-5f65-b36b-c7c245b80118" Condition="AUTOSTART=1">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="NoDrive" Type="string" Value="&quot;[INSTALLFOLDER]NoDrive.Engine.exe&quot;" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Stop a running engine before files are replaced or removed (ignored when none runs). -->
    <CustomAction Id="QuitEngine" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]NoDrive.Engine.exe&quot; --quit --wait 20" Return="ignore" />
    <!-- Final uninstall (not an upgrade): quit, check for unsynced work, unregister the sync root, remove leftovers. Exit code 3 aborts the uninstall. -->
    <CustomAction Id="UninstallEngine" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]NoDrive.Engine.exe&quot; --uninstall" Return="check" />
    <CustomAction Id="LaunchEngine" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]NoDrive.Engine.exe&quot;" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="QuitEngine" Before="InstallValidate" Condition="NOT (REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
      <Custom Action="UninstallEngine" After="InstallInitialize" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchEngine" After="InstallFinalize" Condition="NOT REMOVE AND NOT SUPPRESSLAUNCH" />
    </InstallExecuteSequence>

    <WixVariable Id="WixUILicenseRtf" Value="installer/license.rtf" />
    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
