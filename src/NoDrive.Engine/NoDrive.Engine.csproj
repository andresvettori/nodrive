<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/LowFootprint.props" />
  <PropertyGroup>
    <ApplicationIcon>Assets\nodrive.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <RootNamespace>NoDrive.Engine</RootNamespace>
    <AssemblyName>NoDrive.Engine</AssemblyName>
    <Description>Always-on, headless Native AOT process: tray icon, Cloud Files provider, local watcher, sync engine.</Description>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Native AOT, size-optimised. See memory_bank/techContext.md and research/dotnet-memory.md. -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
    <DebuggerSupport>true</DebuggerSupport>

    <!-- Interop hygiene required for AOT-safe CsWin32 output. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <!-- Some structs (e.g. NOTIFYICONDATAW) are architecture-specific; when building AnyCPU on a dev box pick x64.
         A RID-specific publish (win-x64 / win-arm64) sets PlatformTarget itself. -->
    <CsWin32PlatformTarget Condition="'$(RuntimeIdentifier)' == ''">x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\index.html" LogicalName="index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <!-- The system SQLite (System32\winsqlite3.dll): no native payload shipped. -->
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NoDrive.Core/NoDrive.Core.csproj" />
    <ProjectReference Include="../NoDrive.Graph/NoDrive.Graph.csproj" />
  </ItemGroup>
</Project>
