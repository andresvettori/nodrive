<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/LowFootprint.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>NoDrive.Spikes.Scale</RootNamespace>
    <AssemblyName>scale-500k</AssemblyName>
    <Description>P0 steps 5-6: SQLite index (winsqlite3 on Windows) fed by a fake Graph delta server with 500k items; memory, time and listing latency.</Description>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINSQLITE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <!-- Windows ships winsqlite3.dll in System32: no native payload. Elsewhere (macOS dev box) use the bundled e_sqlite3. -->
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/ProcessStats.cs" Link="Shared/ProcessStats.cs" />
  </ItemGroup>
</Project>
